{
  "ConnectionStrings": {
    "DefaultConnection": "Server=sql-server,1433;Database=IdentityDb;User ID=identity_app;Encrypt=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "IdentityService",
    "Audience": "",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 14,
    "MaxActiveRefreshTokens": 10
  },
  "RsaKeys": {
    "PrivateKeyPath": "",
    "PublicKeyPath": ""
  },
  "Otp": {
    "ExpirationMinutes": 10,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60
  },
  "AllowedHosts": "*",
