    "ApplicationName": "Identity Service",
    "TeamName": "Support Team",
    "ConfirmEmailSubject": "Confirm email",
    "ResetPasswordSubject": "Reset password"
  },
  "EmailOutbox": {
    "MaxDeliveryAttempts": 4,
    "LeaseSeconds": 120,
    "RenewalSeconds": 30,
    "ProcessingTimeoutSeconds": 180
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "From": ""
  },
  "DataProtection": {
    "CertificatePath": "",
    "CertificatePassword": ""
  },
  "Proxy": {
    "KnownProxies": []
  },
  "DevelopmentSetup": {
    "GenerateRsaKeys": false
  }
