
# Copy to .env; never commit .env. Development only.
# Use a strong SQL password without semicolons or quotes (connection string interpolation).
SQL_SA_PASSWORD=
IDENTITY_JWT_AUDIENCE=FitnessApp
IDENTITY_EMAIL_USERNAME=
IDENTITY_EMAIL_PASSWORD=
IDENTITY_EMAIL_FROM=
# Optional SMTP provider settings (defaults: Gmail STARTTLS).
IDENTITY_EMAIL_HOST=smtp.gmail.com
IDENTITY_EMAIL_PORT=587
IDENTITY_EMAIL_ENABLE_SSL=true
