# Copy to .env and fill in. NEVER commit or e-mail/zip the real .env (it is git-ignored, but archives ignore .gitignore).

# Local development: opt in to docker-compose.dev.yml (it is NOT applied automatically any more).
COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=docker-compose.yml,docker-compose.dev.yml

# SQL Server container password. No databases or application logins are provisioned.
SQL_SA_PASSWORD=

# Supply only the connection strings for services you run; choose the database name and credentials yourself.
# Containers reach the included SQL Server at sql-server,1433; host EF tools use localhost,14330.
# Example: IDENTITY_CONNECTION_STRING='Server=sql-server,1433;Database=MyIdentityDb;User Id=my_login;Password=...;Encrypt=True;TrustServerCertificate=True'
PROFILE_CONNECTION_STRING=
IDENTITY_CONNECTION_STRING=
NUTRITION_CONNECTION_STRING=
PAYMENT_CONNECTION_STRING=
PROGRESS_CONNECTION_STRING=
TRAINING_CONNECTION_STRING=

IDENTITY_JWT_AUDIENCE=FitnessApp
IDENTITY_EMAIL_USERNAME=
IDENTITY_EMAIL_PASSWORD=
IDENTITY_EMAIL_FROM=
# Optional SMTP provider settings (defaults: Gmail STARTTLS).
IDENTITY_EMAIL_HOST=smtp.gmail.com
IDENTITY_EMAIL_PORT=587
IDENTITY_EMAIL_ENABLE_SSL=true

# Production only: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d identity-service
# Existing PFX with its private key; use an absolute host path readable by the container user.
IDENTITY_DP_CERTIFICATE_FILE=
IDENTITY_DP_CERTIFICATE_PASSWORD=
