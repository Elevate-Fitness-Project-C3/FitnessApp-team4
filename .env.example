# Copy to .env and fill in. NEVER commit or e-mail/zip the real .env (it is git-ignored, but archives ignore .gitignore).

# Local development: opt in to docker-compose.dev.yml (it is NOT applied automatically any more).
COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=docker-compose.yml,docker-compose.dev.yml

# SQL Server container password. No databases or application logins are provisioned.
SQL_SA_PASSWORD=

# Identity and Audit keep their SQL connection settings in their own appsettings files.
# Add only the passwords for the existing application logins on the SQL server.
IDENTITY_SQL_PASSWORD=
AUDIT_SQL_PASSWORD=

# Connection strings for the other services, when used.
# Containers reach the included SQL Server at sql-server,1433; host EF tools use localhost,14330.
PROFILE_CONNECTION_STRING=
NUTRITION_CONNECTION_STRING=
PAYMENT_CONNECTION_STRING=
PROGRESS_CONNECTION_STRING=
TRAINING_CONNECTION_STRING=

IDENTITY_JWT_AUDIENCE=FitnessApp
IDENTITY_EMAIL_USERNAME=
IDENTITY_EMAIL_PASSWORD=
IDENTITY_EMAIL_FROM=
# Optional SMTP provider settings (defaults: Gmail STARTTLS).
IDENTITY_EMAIL_HOST=smtp.gmail.com
IDENTITY_EMAIL_PORT=587
IDENTITY_EMAIL_ENABLE_SSL=true
IDENTITY_APPLICATION_NAME=Identity Service
IDENTITY_TEAM_NAME=Support Team
IDENTITY_CONFIRM_EMAIL_SUBJECT=Confirm email
IDENTITY_RESET_PASSWORD_SUBJECT=Reset password

# Optional local audit stack. Use distinct RabbitMQ accounts and strong passwords.
AUDIT_SERVICE_DIRECTORY=./AuditService
AUDIT_ENVIRONMENT=Development
AUDIT_BROKER_ADMIN_USER=audit_admin
AUDIT_BROKER_ADMIN_PASSWORD=
AUDIT_BROKER_USER=audit_consumer
AUDIT_BROKER_PASSWORD=
IDENTITY_AUDIT_BROKER_USER=identity_publisher
IDENTITY_AUDIT_BROKER_PASSWORD=
AUDIT_BROKER_PORT=5672
IDENTITY_AUDIT_BROKER_PORT=5672
AUDIT_BROKER_USE_TLS=false
IDENTITY_AUDIT_BROKER_USE_TLS=false
AUDIT_MESSAGING_ENABLED=false
IDENTITY_AUDIT_MESSAGING_ENABLED=false
AUDIT_IDENTITY_BASE_URL=http://identity-service:8080
# Use separate random values of at least 32 characters.
AUDIT_REPORTING_SERVICE_KEY=
AUDIT_REPORTING_CURSOR_KEY=

# Production only: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d identity-service
# Existing PFX with its private key; use an absolute host path readable by the container user.
IDENTITY_DP_CERTIFICATE_FILE=
IDENTITY_DP_CERTIFICATE_PASSWORD=
